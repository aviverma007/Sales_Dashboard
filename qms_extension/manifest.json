{
  "manifest_version": 3,
  "name": "QMS Data Bridge",
  "version": "1.0",
  "description": "Auto-fetches QMS data for PRPO Dashboard",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://smartworlddevelopersonline.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
